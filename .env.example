# Copy to .env (never commit .env). Every value is optional for a local demo.

# --- LLM providers (server-side only; never exposed to the browser) ---
# Without keys the app uses the offline "heuristic" provider for classification,
# extraction and briefs. Add any subset of these to enable the LLM providers.
LLM_DEFAULT_PROVIDER=heuristic        # heuristic | openai | anthropic | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5        # claude-haiku-5-5 is a cheaper option for bulk classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REVIEW_CONFIDENCE_THRESHOLD=0.75       # below this, classifications go to the review queue

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
SEED_PASSWORD=strata-demo-2026         # password for the seeded demo users
COOKIE_SECURE=false                    # true behind HTTPS
ALLOW_SIGNUP=true

# --- Ingestion ---
# SEC asks automated clients to identify themselves with a contact.
SEC_USER_AGENT="Your Name your-email@example.com"
GITHUB_TOKEN=
SCHEDULE_INGESTION=false               # true: worker refreshes YC + Form D daily

# --- Infrastructure (docker compose sets these for you) ---
# MONGO_URL=mongodb://localhost:27017/strata
# REDIS_URL=redis://localhost:6379
# EVENT_BUS=kafka                      # kafka | redis | memory
# KAFKA_BROKERS=localhost:19092
# INLINE_WORKER=false                  # true: API process also runs consumers + jobs (hosted demo)
# TRUST_PROXY_HOPS=1                  # 2 behind Vercel + Render (docs/DEPLOY.md)
